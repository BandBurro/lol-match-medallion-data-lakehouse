# Your Linux UID — run: id -u
AIRFLOW_UID=50000

# Extra pip packages installed in containers at startup
_PIP_ADDITIONAL_DEPENDENCIES=apache-airflow-providers-databricks

# Stable Fernet key for cross-restart secret encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=

# Optional: override env file path when running docker compose from inside infra/
# ENV_FILE_PATH=../.env
